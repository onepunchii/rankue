#!/usr/bin/expect

# Set infinite timeout
set timeout -1

# Spawn the process directly
spawn npx drizzle-kit push --verbose

# Expect loop
expect {
    # Match "created or renamed"
    -re "created or renamed" { 
        # sleep 0.5
        send "\r"
        exp_continue 
    }
    
    # Match "truncate" prompt
    -re "truncate" { 
        # sleep 0.5
        send "\r"
        exp_continue 
    }
    
    # Match final confirmation
    -re "Do you still want to push changes?" { 
        # Send Down Arrow (ESC [ B) then Enter
        sleep 1
        send "\033\[B"
        sleep 1
        send "\r"
        exp_continue
    }
    
    # Check for success completion
    -re "Applied" { 
        puts "Success" 
    }
    
    eof { 
        puts "Finished" 
    }
}
